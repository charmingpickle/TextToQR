<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
  <meta name="theme-color" content="#111" />
  <title>Scan → Select Line → QR</title>
  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #111; color: #eee;
      min-height: 100dvh; display: flex; flex-direction: column;
    }
    header {
      padding: 12px 16px; background: #1a1a1a;
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 1px solid #333;
    }
    h1 { font-size: 1.1rem; font-weight: 600; }
    button {
      background: #0a84ff; color: white; border: none;
      padding: 10px 16px; border-radius: 8px; font-size: 1rem;
      cursor: pointer; touch-action: manipulation;
    }
    button:disabled { opacity: 0.5; }
    button.secondary { background: #333; }
    #camera-view, #result-view { flex: 1; display: flex; flex-direction: column; }
    #video-container {
      position: relative; flex: 1; background: #000;
      display: flex; align-items: center; justify-content: center;
    }
    video, canvas {
      max-width: 100%; max-height: 60vh; object-fit: contain;
    }
    #overlay {
      position: absolute; inset: 0; pointer-events: none;
      border: 2px solid #0a84ff; border-radius: 8px; margin: 12px;
    }
    .controls {
      padding: 16px; display: flex; gap: 12px; justify-content: center;
      background: #1a1a1a; border-top: 1px solid #333;
    }
    #lines {
      flex: 1; overflow-y: auto; padding: 12px;
      display: flex; flex-direction: column; gap: 8px;
    }
    .line {
      background: #222; padding: 12px 16px; border-radius: 8px;
      font-size: 1rem; line-height: 1.4; cursor: pointer;
      border: 2px solid transparent; word-break: break-word;
    }
    .line:active, .line.selected { border-color: #0a84ff; background: #1a2a3a; }
    #qr-section {
      padding: 16px; text-align: center; background: #1a1a1a;
      border-top: 1px solid #333;
    }
    #qrcode { margin: 12px auto; background: white; padding: 12px; border-radius: 8px; display: inline-block; }
    #qrcode canvas { display: block; }
    .status { font-size: 0.9rem; color: #aaa; padding: 8px 16px; text-align: center; }
    .hidden { display: none !important; }
  </style>
</head>
<body>
  <header>
    <h1>Scan → Line → QR</h1>
    <button id="btn-switch" class="secondary" style="padding:8px 12px;font-size:0.85rem">Front</button>
  </header>

  <div id="camera-view">
    <div class="status" id="status">Point at a screen / document and capture</div>
    <div id="video-container">
      <video id="video" autoplay playsinline muted></video>
      <div id="overlay"></div>
    </div>
    <div class="controls">
      <button id="btn-capture">Capture &amp; OCR</button>
    </div>
  </div>

  <div id="result-view" class="hidden">
    <div class="status">Tap a line to generate QR</div>
    <div id="lines"></div>
    <div id="qr-section" class="hidden">
      <div id="qrcode"></div>
      <p style="margin-top:8px;font-size:0.9rem;color:#aaa">Scan this with another device</p>
      <button id="btn-back" class="secondary" style="margin-top:12px">← Back to camera</button>
    </div>
  </div>

  <script>
    const video = document.getElementById('video');
    const statusEl = document.getElementById('status');
    const linesEl = document.getElementById('lines');
    const qrSection = document.getElementById('qr-section');
    const qrcodeEl = document.getElementById('qrcode');
    const cameraView = document.getElementById('camera-view');
    const resultView = document.getElementById('result-view');

    let stream = null;
    let facingMode = 'environment'; // back camera
    let worker = null;

    async function startCamera() {
      if (stream) stream.getTracks().forEach(t => t.stop());
      try {
        stream = await navigator.mediaDevices.getUserMedia({
          video: {
            facingMode,
            width: { ideal: 1280 },
            height: { ideal: 720 }
          },
          audio: false
        });
        video.srcObject = stream;
        statusEl.textContent = 'Point at text and tap Capture';
      } catch (err) {
        statusEl.textContent = 'Camera error: ' + err.message;
        console.error(err);
      }
    }

    document.getElementById('btn-switch').onclick = () => {
      facingMode = facingMode === 'environment' ? 'user' : 'environment';
      document.getElementById('btn-switch').textContent = facingMode === 'environment' ? 'Front' : 'Back';
      startCamera();
    };

    document.getElementById('btn-capture').onclick = async () => {
      if (!stream) return;
      const btn = document.getElementById('btn-capture');
      btn.disabled = true;
      statusEl.textContent = 'Capturing & running OCR… (may take a few seconds)';

      // Capture frame
      const canvas = document.createElement('canvas');
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(video, 0, 0);

      // OCR
      try {
        if (!worker) {
          worker = await Tesseract.createWorker('eng'); // add more langs if needed: 'eng+chi_sim' etc.
        }
        const { data: { text, lines } } = await worker.recognize(canvas);

        // Prefer structured lines if available, otherwise split text
        let lineList = [];
        if (lines && lines.length) {
          lineList = lines
            .filter(l => l.text.trim().length > 1)
            .map(l => l.text.trim());
        } else {
          lineList = text.split(/\n+/).map(l => l.trim()).filter(l => l.length > 1);
        }

        if (lineList.length === 0) {
          statusEl.textContent = 'No text detected. Try again with better lighting / closer.';
          btn.disabled = false;
          return;
        }

        // Show lines
        linesEl.innerHTML = '';
        lineList.forEach((line, i) => {
          const div = document.createElement('div');
          div.className = 'line';
          div.textContent = line;
          div.onclick = () => selectLine(line, div);
          linesEl.appendChild(div);
        });

        cameraView.classList.add('hidden');
        resultView.classList.remove('hidden');
        qrSection.classList.add('hidden');
        statusEl.textContent = 'Tap a line';
      } catch (err) {
        statusEl.textContent = 'OCR failed: ' + err.message;
        console.error(err);
      }
      btn.disabled = false;
    };

    function selectLine(text, el) {
      document.querySelectorAll('.line').forEach(l => l.classList.remove('selected'));
      el.classList.add('selected');

      qrcodeEl.innerHTML = '';
      QRCode.toCanvas(document.createElement('canvas'), text, {
        width: 256,
        margin: 2,
        errorCorrectionLevel: 'M'
      }, (err, canvas) => {
        if (err) {
          qrcodeEl.textContent = 'QR error: ' + err;
          return;
        }
        qrcodeEl.appendChild(canvas);
        qrSection.classList.remove('hidden');
      });
    }

    document.getElementById('btn-back').onclick = () => {
      resultView.classList.add('hidden');
      cameraView.classList.remove('hidden');
      statusEl.textContent = 'Point at text and tap Capture';
    };

    // Init
    startCamera();
  </script>
</body>
</html>
